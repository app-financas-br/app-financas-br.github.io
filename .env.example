# Copie para .env.local e preencha. .env.local NÃO vai para o Git.
# Ambos os valores são públicos por design (vão para o navegador).
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx_ou_a_chave_anon_legada

# NUNCA coloque aqui: chave secret/service_role, senha do banco, GROQ_API_KEY.
# A GROQ_API_KEY vai só em: supabase secrets set GROQ_API_KEY=...
